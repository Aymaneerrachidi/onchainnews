/output/
/overlays/
/brand details/
/.venv/
/.pytest_cache/
/.ruff_cache/
/.playwright-mcp/
/brief/
/scripts/
/tests/
__pycache__/
*.db
*.db-wal
*.db-shm
*.log
*.png
/uv.lock
/pyproject.toml
/config.toml
/.env
/.env.example

# Secrets
.env

# Environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.playwright-mcp/
web/.playwright-mcp/

# Local pipeline state. Anchored with a leading slash on purpose: an
# unanchored "data/" also matches web/data/, which is the snapshot the
# deployed site renders and therefore must stay tracked.
/data/
/output/*.html
!/output/.gitkeep
/output/pulse-images/

# Vercel local project link
.vercel/

# Local reference material and installers, not project source
/overlays/*
!/overlays/fomo-runner-template.jpg
/brand details/
*.exe
*.crdownload
/output/*.png

# Local scratch and one-off artefacts that keep landing in the root.
/tmp-debug/
/runners-newsletter.html
/x post example.jpg

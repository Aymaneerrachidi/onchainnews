# Optional keyed sources. The brief runs without these.
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# GMGN read-only market/KOL/smart-money discovery. Create a key from
# `gmgn-cli config`, then apply it locally with `gmgn-cli config --apply`.
# Unattended GitHub Actions reads this environment variable directly.
GMGN_API_KEY=

# Optional 6551 token used by both OpenNews and OpenTwitter finalist searches.
# Without it, the scanner still uses the no-auth broad crypto hot feed.
OPENNEWS_TOKEN=

# Optional Dune query API used by the Pump.fun wallet discovery lane.
DUNE_API_KEY=

# X API bearer token. When present, the daily run searches public posts from
# the handles listed in config.toml [x].accounts and links matched evidence to
# each highlighted coin. X access is not required for the report to ship.
X_BEARER_TOKEN=

# Optional X posting token for the hourly pulse. This must be a user-context
# OAuth token with tweet.write and media.write scopes. It is different from the
# read/search bearer token above.
X_USER_ACCESS_TOKEN=

# Better for unattended X posting: OAuth 1.0a user context. In the X app,
# switch permissions from Read to Read and write, then regenerate the access
# token and secret for the posting account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional OpenAI image generation for runner posters.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Required for the morning Telegram digest and the between-brief watcher alerts.
# Create a bot with @BotFather to get the token, then message the bot once and
# read the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# After filling these in, set delivery.telegram_enabled = true in config.toml.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email delivery. Recommended no-SMTP provider: Brevo API
# (free daily allowance). Create an API key in Brevo, then set
# delivery.email_provider = "brevo" in config.toml.
BREVO_API_KEY=

# Optional fallback email delivery via Resend. Resend's test sender only
# delivers to your own account email unless you verify a domain.
RESEND_API_KEY=

# Cohere writes the daily recap when [newsletter].provider = "cohere".
COHERE_API_KEY=

# Discord channel webhook for the daily recap. Anyone holding this can post
# to the channel, so it never leaves .env.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_SECONDARY=

# Required only for the in-Discord "Refresh live MC" button. Invite the bot
# with View Channel and Send Messages, set its interaction endpoint to
# https://YOUR-VERCEL-DOMAIN/api/discord-interactions, then copy the bot token,
# application public key and target channel id here. Vercel only needs the
# public key; keep the bot token wherever the sender itself runs.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_ID_SECONDARY=

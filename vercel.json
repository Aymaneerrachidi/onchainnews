{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web",
  "framework": null,
  "headers": [
    {
      "source": "/data/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/overlay",
      "destination": "/overlay.html"
    },
    {
      "source": "/control",
      "destination": "/control.html"
    },
    {
      "source": "/join",
      "destination": "/access.html"
    },
    {
      "source": "/member-site",
      "destination": "/api/member-access?action=site"
    }
  ]
}
